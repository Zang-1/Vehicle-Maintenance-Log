.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Not needed at run time
docs/
tests/
db/
*.md
pytest.ini
requirements-dev.txt
compose.yml
Dockerfile
.dockerignore

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
