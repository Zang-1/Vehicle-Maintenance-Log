# Copy this file to .env and fill in values. Never commit .env.
# DB_PASSWORD: letters and digits only (read by compose.yml, which builds DATABASE_URL with host "db").
DB_PASSWORD=
APP_NAME=vehicle-maintenance-log
APP_ENV=development
# Only needed when running without Compose. On Render: the Supabase transaction pooler URI (port 6543).
DATABASE_URL=
# Google AI Studio key for /diagnose (M7). The app still starts without it.
GEMINI_API_KEY=
# Optional — defaults shown (app/ai.py):
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.5-flash-lite
